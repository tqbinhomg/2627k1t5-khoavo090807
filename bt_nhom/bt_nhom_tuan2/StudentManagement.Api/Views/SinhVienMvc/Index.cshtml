@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Quản lý sinh viên";
}
<div class="card mt-4 shadow">
    <div class="card-header bg-primary text-white fs-4 d-flex justify-content-between align-items-center">
        <a href="/SinhVienMvc/Index" class="text-white text-decoration-none" title="Refresh trang">Quản lý Sinh viên</a>
    </div>
    <div class="card-body">
        <form class="row g-2 mb-3 align-items-center" method="get">
            <div class="col-auto">
                <input class="form-control" name="searchMasv" value="@ViewBag.SearchMasv" placeholder="Tìm Mã SV..." />
            </div>
            <div class="col-auto">
                <input class="form-control" name="filterMalop" value="@ViewBag.FilterMalop" placeholder="Lọc Mã lớp..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Tìm/Lọc</button>
                <a href="/SinhVienMvc/Create" class="btn btn-success ms-2">+ Thêm sinh viên</a>
                <a href="/DashboardMvc/Index" class="btn btn-info ms-2">Dashboard</a>
                <button type="button" class="btn btn-danger ms-2" onclick="deleteClassDialog()">Xoá lớp</button>
                <div class="modal fade" id="deleteClassModal" tabindex="-1" aria-labelledby="deleteClassModalLabel" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title">Xoá toàn bộ sinh viên lớp</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                      </div>
                      <div class="modal-body">
                        <label>Nhập mã lớp cần xoá:</label>
                        <input id="delMalop" type="text" class="form-control mt-2" maxlength="20">
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Huỷ</button>
                        <button type="button" class="btn btn-danger" onclick="confirmDeleteClass()">Xoá</button>
                      </div>
                    </div>
                  </div>
                </div>
            </div>
        </form>
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Mã</th>
                    <th>Tên</th>
                    <th>Tuổi</th>
                    <th>Giới tính</th>
                    <th>Lớp</th>
                    <th>Ngoại ngữ</th>
                    <th>Môn học</th>
                    <th>Điểm</th>
                    <th>ĐTB</th>
                    <th>Xếp loại</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @{
                    var scoreDict = ViewBag.StudentScoreAvg as Dictionary<string, (double score, string rank)> ?? new Dictionary<string, (double, string)>();
                }
                @foreach(var s in Model){
                    int rowSpan = s.Monhoc != null && s.Monhoc.Count > 0 ? s.Monhoc.Count : 1;
                    bool firstRow = true;
                    var scoreInfo = scoreDict.ContainsKey(s.Masv) ? scoreDict[s.Masv] : (0.0, "");
                    if(s.Monhoc != null && s.Monhoc.Count > 0){
                        foreach(var m in s.Monhoc){
                            <tr>
                                @if(firstRow){
                                    <td rowspan="@rowSpan">@s.Masv</td>
                                    <td rowspan="@rowSpan">@s.Hoten</td>
                                    <td rowspan="@rowSpan">@s.Tuoi</td>
                                    <td rowspan="@rowSpan">@s.Phai</td>
                                    <td rowspan="@rowSpan">@s.Malop</td>
                                    <td rowspan="@rowSpan">
                                        @if(s.Ngoaingu != null) {
                                            foreach(var lang in s.Ngoaingu) {
                                                <span class="badge bg-info text-dark me-1">@lang</span>
                                            }
                                        }
                                    </td>
                                }
                                <td>@m.Tenmon</td>
                                <td>@(m.Diem.ToString("F2").Replace('.', ','))</td>
                                @if(firstRow){
                                    <td rowspan="@rowSpan">
                                        @if(scoreInfo.Item1 > 0) {
                                            @scoreInfo.Item1.ToString("F2").Replace('.', ',')
                                        }
                                    </td>
                                    <td rowspan="@rowSpan">
                                        @if(scoreInfo.Item1 > 0) {
                                            <span class="badge bg-@GetRankBadgeClass(scoreInfo.Item2)">@scoreInfo.Item2</span>
                                        }
                                    </td>
                                    <td rowspan="@rowSpan" style="white-space:nowrap;">
                                        <a href="/SinhVienMvc/Edit/@s.Id" class="btn btn-warning btn-sm">Sửa</a>
                                        <a href="/SinhVienMvc/Delete/@s.Id" class="btn btn-danger btn-sm ms-1">Xoá</a>
                                    </td>
                                }
                            </tr>
                            firstRow = false;
                        }
                    }else{
                        <tr>
                            <td>@s.Masv</td>
                            <td>@s.Hoten</td>
                            <td>@s.Tuoi</td>
                            <td>@s.Phai</td>
                            <td>@s.Malop</td>
                            <td>
                                @if(s.Ngoaingu != null) {
                                    foreach(var lang in s.Ngoaingu) {
                                        <span class="badge bg-info text-dark me-1">@lang</span>
                                    }
                                }
                            </td>
                            <td></td>
                            <td></td>
                            <td>
                                @if(scoreInfo.Item1 > 0) {
                                    @scoreInfo.Item1.ToString("F2").Replace('.', ',')
                                }
                            </td>
                            <td>
                                @if(scoreInfo.Item1 > 0) {
                                    <span class="badge bg-@GetRankBadgeClass(scoreInfo.Item2)">@scoreInfo.Item2</span>
                                }
                            </td>
                            <td style="white-space:nowrap;">
                                <a href="/SinhVienMvc/Edit/@s.Id" class="btn btn-warning btn-sm">Sửa</a>
                                <a href="/SinhVienMvc/Delete/@s.Id" class="btn btn-danger btn-sm ms-1">Xoá</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    string GetRankBadgeClass(string rank) {
        return rank switch {
            "Xuất sắc" => "success",
            "Giỏi" => "primary",
            "Khá" => "warning",
            "Trung bình/Yếu" => "danger",
            _ => "secondary"
        };
    }
}

<script>
function deleteClassDialog() {
    var modal = document.getElementById('deleteClassModal');
    if (window.bootstrap) {
        var bsModal = new bootstrap.Modal(modal);
        bsModal.show();
    } else {
        modal.style.display = 'block';
    }
}
function confirmDeleteClass() {
    var malop = document.getElementById('delMalop').value.trim();
    if(!malop) { alert('Vui lòng nhập mã lớp'); return; }
    if(!confirm('Bạn chắc chắn muốn xoá toàn bộ sinh viên thuộc lớp '+malop+'?')) return;
    var modal = document.getElementById('deleteClassModal');
    fetch('/api/student/by-class/'+encodeURIComponent(malop), {
        method: 'DELETE',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(async r=>{
        if(r.ok) {
            let d = await r.json();
            alert('Đã xoá '+d+' sinh viên thuộc lớp '+malop);
            if(window.bootstrap) bootstrap.Modal.getInstance(modal)?.hide();
            window.location.reload();
        } else {
            let t = await r.text();
            alert('Lỗi xóa lớp: '+t);
        }
    })
    .catch(err=>alert('Lỗi kết nối với server: '+err));
}
</script>