@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Xoá sinh viên";
}
<div class="card mx-auto mt-5" style="max-width:400px;">
<div class="card-header bg-danger text-white">Xoá sinh viên</div>
<div class="card-body">
<b>Bạn chắc chắn muốn xoá SV <span class="text-danger">@Model.Masv - @Model.Hoten</span>?</b>
<form method="post" class="mt-3">
<input type="hidden" name="Id" value="@Model.Id" />
<button type="submit" class="btn btn-danger">Xoá</button> <a href="/SinhVienMvc/Index" class="btn btn-secondary">Huỷ</a>
</form>
</div>
</div>