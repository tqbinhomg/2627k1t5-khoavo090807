@model StudentModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Thêm sinh viên";
}
<div class="card mx-auto mt-5 shadow" style="max-width:520px;">
<div class="card-header bg-success text-white fs-5">Thêm Sinh viên</div>
<div class="card-body">
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}
<form method="post" autocomplete="off" id="svForm">
    <div class="mb-2">
        <label class="form-label">Mã SV</label>
        <input class="form-control @(ViewData.ModelState["Masv"]?.Errors.Count > 0 ? "is-invalid" : "")" name="Masv" value="@Model?.Masv" required />
        <span class="text-danger">@Html.ValidationMessage("Masv")</span>
    </div>
    <div class="mb-2">
        <label class="form-label">Họ Tên</label>
        <input class="form-control" name="Hoten" value="@Model?.Hoten" required />
    </div>
    <div class="mb-2">
        <label class="form-label">Tuổi</label>
        <input class="form-control @(ViewData.ModelState["Tuoi"]?.Errors.Count > 0 ? "is-invalid" : "")" type="number" min="1" max="100" name="Tuoi" value="@Model?.Tuoi" required />
        <span class="text-danger">@Html.ValidationMessage("Tuoi")</span>
        <small class="form-text text-muted">Nhập số nguyên lớn hơn 0</small>
    </div>
    <div class="mb-2">
        <label class="form-label">Giới tính</label>
        <select class="form-select" name="Phai">
            <option value="Nam" @(Model?.Phai == "Nam" ? "selected" : "")>Nam</option>
            <option value="Nữ" @(Model?.Phai == "Nữ" ? "selected" : "")>Nữ</option>
        </select>
    </div>
    <div class="mb-2">
        <label class="form-label">Mã lớp</label>
        <input class="form-control" name="Malop" value="@Model?.Malop" required />
    </div>
    <div class="mb-2">
    <label class="form-label">Ngoại ngữ</label>
    <button type="button" onclick="addLanguage()" class="btn btn-outline-success btn-sm ms-2">+ Thêm ngoại ngữ</button>
    <div id="langArea"></div>
</div>
    <div class="mb-2 border rounded p-2">
        <label class="form-label">Môn học</label>
        <button type="button" onclick="addSubject()" class="btn btn-outline-success btn-sm ms-2">+ Thêm môn</button>
        <div id="subjectArea"></div>
    </div>
    <button type="submit" class="btn btn-success">Lưu</button>
    <a href="/SinhVienMvc/Index" class="btn btn-secondary ms-2">Huỷ</a>
</form>
<script>
let langCount = 0;
function addLanguage(val = "") {
    const area = document.getElementById('langArea');
    const idx = langCount++;
    const div = document.createElement('div');
    div.className = 'row g-1 align-items-end mb-1';
    div.innerHTML = `<div class="col-9">
        <input name="Ngoaingu[${idx}]" class="form-control form-control-sm" placeholder="Ngoại ngữ" required value="${val}">
    </div>
    <div class="col-auto">
        <button type="button" onclick="this.parentElement.parentElement.remove()" class="btn btn-danger btn-sm">X</button>
    </div>`;
    area.appendChild(div);
}
document.getElementById('svForm')?.addEventListener('submit', function(e) {
    // Validation tuổi
    const tuoiInput = this.querySelector('input[name="Tuoi"]');
    const tuoiValue = parseInt(tuoiInput.value);
    if (isNaN(tuoiValue) || tuoiValue <= 0 || tuoiValue > 100) {
        alert("Tuổi phải là số nguyên lớn hơn 0 và nhỏ hơn hoặc bằng 100");
        tuoiInput.focus();
        e.preventDefault();
        return;
    }

    // Validation điểm
    let sInputs = this.querySelectorAll('input[name^="Monhoc"][name$=".Diem"]');
    let ok = true;
    sInputs.forEach(inp=>{
        if(inp.value.includes(',')) inp.value = inp.value.replace(',', '.');
        let v = parseFloat(inp.value);
        if(isNaN(v) || v < 0 || v > 10) {
            ok = false;
            inp.classList.add("is-invalid");
        } else {
            inp.classList.remove("is-invalid");
        }
    });
    if(!ok) {
        alert("Điểm phải là số thực từ 0 đến 10, dùng dấu chấm hoặc dấu phẩy.");
        e.preventDefault();
    }
});
let subjectCount = 0;
function addSubject(mamon='', tenmon='', diem='') {
    const area = document.getElementById('subjectArea');
    const idx = subjectCount++;
    const div = document.createElement('div');
    div.className = 'row g-1 align-items-end mb-1';
    div.innerHTML = `
        <div class="col">
            <input name="Monhoc[${idx}].Mamon" class="form-control form-control-sm" placeholder="Mã môn" required value="${mamon}">
        </div>
        <div class="col">
            <input name="Monhoc[${idx}].Tenmon" class="form-control form-control-sm" placeholder="Tên môn" required value="${tenmon}">
        </div>
        <div class="col-2">
            <input name="Monhoc[${idx}].Diem" class="form-control form-control-sm" type="text" step="0.01" min="0" max="10" placeholder="Điểm" required value="${diem}">
        </div>
        <div class="col-auto">
            <button type="button" onclick="this.parentElement.parentElement.remove()" class="btn btn-danger btn-sm">X</button>
        </div>`;
    area.appendChild(div);
}
// Khôi phục dữ liệu nếu có lỗi validation
@if (Model?.Ngoaingu != null && Model.Ngoaingu.Count > 0)
{
    foreach (var lang in Model.Ngoaingu)
    {
        <text>addLanguage('@lang');</text>
    }
}
@if (Model?.Monhoc != null && Model.Monhoc.Count > 0)
{
    foreach (var m in Model.Monhoc)
    {
        <text>addSubject('@m.Mamon', '@m.Tenmon', '@m.Diem');</text>
    }
}
</script>
</div>
</div>